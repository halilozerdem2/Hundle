{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "ts-node --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "sync-news": "tsx src/syncNewsPool.ts",
    "sync-news-full": "tsx src/fullSyncNewsPool.ts"
  },
  "dependencies": {
    "@news/news-core": "workspace:*",
    "@news/push-core": "workspace:*",
    "@news/shared": "workspace:*",
    "node-cron": "3.0.3"
  },
  "devDependencies": {
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.7.0",
    "typescript": "5.4.5"
  }
}
